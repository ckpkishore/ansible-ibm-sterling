apiVersion: v1
kind: ConfigMap
metadata:
  name: sftp-known-hosts
  namespace: {{ sftp_client_namespace }}
  labels:
    app: sftp-client
    app.kubernetes.io/name: sftp-client
    app.kubernetes.io/part-of: ibm-redhat-sftp
data:
  # Populate known_hosts with your remote server's host key to enable
  # strict host-key checking (recommended for production).
  # Example:
  #   known_hosts: |
  #     remote-host.example.com ssh-rsa AAAA...
  #
  # Leave empty to let the first connection auto-accept the host key
  # (StrictHostKeyChecking=accept-new will be used by the pod).
  known_hosts: |
    # Add remote host keys here — one entry per line.
    # Format: <hostname> <keytype> <base64-pubkey>
