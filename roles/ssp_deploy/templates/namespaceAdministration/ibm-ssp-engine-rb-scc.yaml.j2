apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: "ibm-ssp-engine-scc"
  namespace: {{ ssp_namespace }}
  labels:
    app: "ibm-ssp-engine-scc"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: "ibm-ssp-engine-scc"
subjects:
  - kind: ServiceAccount
    name: ssp-engine-sa
    namespace: {{ ssp_namespace }}
