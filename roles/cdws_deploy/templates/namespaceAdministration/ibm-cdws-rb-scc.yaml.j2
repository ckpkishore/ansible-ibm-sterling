apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: "ibm-cdws-scc"
  namespace: {{ cdws_namespace }}
  labels:
    app: "ibm-cdws-scc"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: "ibm-cdws-scc"
subjects:
  - kind: ServiceAccount
    name: default
    namespace: {{ cdws_namespace }}